# =============================================================================
# ConversalX MVP — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# RAG (Retrieval-Augmented Generation) & Knowledge Base
KNOWLEDGE_DIR=data/knowledge
CHROMA_URL=http://localhost:8000
EMBEDDING_MODEL=all-MiniLM-L6-v2             # Local ONNX model
RAG_CACHE_TTL_MIN=10                        # Re-index every 10 mins if changed

# Token & Session Management
SESSION_COMPACTION_TURNS=5                  # Compact every 5 responses
SESSION_IDLE_COMPACTION_MS=120000           # Compact after 2 mins idle (120000ms)
COMPACTION_MODEL=phi3:mini       # Model to use for summarization

# Data Retention
RETENTION_DAYS=7                            # Default 7, max 30

# Dev mode: when true, sends raw LLM + policy decision to WhatsApp for debugging
DEV_MODE=true

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0

# Set to "true" to use a local mock instead of real WhatsApp API
WHATSAPP_MOCK_MODE=true

# --- LLM Provider ---
# Options: ollama (local) | groq | openai | gemini
# Use "ollama" for local dev (no API key needed)
# Use "groq" or others for deployment
LLM_PROVIDER=ollama

# Ollama (local Docker model — FREE, no API key)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Groq (recommended for deployment — free tier, ultra-fast)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (alternative)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# LLM Settings
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3

# --- OPA (Open Policy Agent) ---
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/v1/data/conversalx
OPA_TIMEOUT_MS=2000

# --- Industry Configuration ---
DEFAULT_INDUSTRY=education
ALLOWED_INDUSTRIES=education,health

# --- Admin ---
ADMIN_API_KEY=change-me-in-production

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=logs
