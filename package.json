{
  "name": "conv-mvp",
  "version": "1.0.0",
  "description": "ConvAI — Policy Governed Decision Engine",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "start:safe": "node scripts/checkOllama.js && npm run dev",
    "check:ollama": "node scripts/checkOllama.js",
    "ingest:data": "node scripts/ingestExcelData.js",
    "health:check": "node -e \"require('http').get('http://localhost:3000/health/full',(r)=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>console.log(JSON.stringify(JSON.parse(d),null,2)))}).on('error',e=>console.error('Backend not running:',e.message))\"",
    "health:full": "node -e \"require('http').get('http://localhost:3000/health/full',(r)=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>console.log(JSON.stringify(JSON.parse(d),null,2)))}).on('error',e=>console.error(e.message))\"",
    "opa:start": "docker run -d --name opa -p 8181:8181 -v $(pwd)/src/policies:/policies openpolicyagent/opa:latest run --server --addr :8181 /policies",
    "opa:stop": "docker stop opa && docker rm opa",
    "opa:test": "docker run --rm -v $(pwd)/src/policies:/policies openpolicyagent/opa:latest test /policies -v",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "node --test src/__tests__/**/*.test.js",
    "test:education": "node scripts/testEducationRoles.js",
    "test:education:teacher": "node scripts/testEducationRoles.js --role teacher",
    "test:education:parent": "node scripts/testEducationRoles.js --role parent",
    "evals": "node scripts/runEvals.js",
    "evals:safety": "node scripts/runEvals.js --category safety",
    "evals:dry": "node scripts/runEvals.js --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashishnigam1989/Conv-mvp.git"
  },
  "keywords": [
    "convai",
    "policy-engine",
    "opa",
    "whatsapp",
    "chatbot"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ashishnigam1989/Conv-mvp/issues"
  },
  "homepage": "https://github.com/ashishnigam1989/Conv-mvp#readme",
  "dependencies": {
    "@xenova/transformers": "2.0.1",
    "axios": "1.15.1",
    "body-parser": "2.2.2",
    "chokidar": "3.6.0",
    "chromadb": "1.10.4",
    "cors": "2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "17.3.1",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "groq-sdk": "0.18.0",
    "helmet": "8.1.0",
    "mammoth": "1.12.0",
    "openai": "4.104.0",
    "pdf-parse": "1.1.1",
    "tiktoken": "1.0.21",
    "uuid": "11.1.0",
    "winston": "3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "3.1.0"
  },
  "nodemonConfig": {
    "ignore": [
      "logs/*",
      "data/*",
      "traces/*",
      "*.json",
      "scripts/*"
    ]
  }
}
